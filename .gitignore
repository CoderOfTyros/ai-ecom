@"
# dependencies
**/node_modules/
**/.pnp
**/.pnp.*
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/versions

# env files (never commit secrets)
**/.env
**/.env.*
!**/.env.example

# Next.js
**/.next/
**/out/

# builds
**/dist/
**/build/

# testing / coverage
**/coverage/
**/.nyc_output/

# logs
**/logs/
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# temp
**/tmp/
**/temp/
**/*.tmp

# caches
**/.eslintcache
**/.cache/
**/*.tsbuildinfo

# hosting
**/.vercel/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
"@ | Set-Content -Encoding UTF8 .gitignore
